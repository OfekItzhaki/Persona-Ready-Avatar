# Azure Speech Service Configuration
# Get your Azure Speech API key from: https://portal.azure.com
# Note: These are exposed to the browser for voice input functionality
NEXT_PUBLIC_AZURE_SPEECH_KEY=your_azure_speech_api_key_here
NEXT_PUBLIC_AZURE_SPEECH_REGION=your_azure_region_here

# Server-Side Azure Speech (for server-side TTS if needed)
AZURE_SPEECH_KEY=your_azure_speech_api_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Brain API Configuration
# Server-Side Only: Brain API URL (not exposed to browser)
BRAIN_API_URL=http://localhost:3000/api

# Client-Side: Local API proxy (exposed to browser)
NEXT_PUBLIC_BRAIN_API_URL=/api

# Client-Side Configuration (NEXT_PUBLIC_* variables are exposed to the browser)
# Default 3D avatar model URL (set to empty to use fallback by default)
NEXT_PUBLIC_AVATAR_MODEL_URL=

# Ready Player Me is discontinued - using fallback avatars instead
# NEXT_PUBLIC_AVATAR_DEFAULT_1=
# NEXT_PUBLIC_AVATAR_DEFAULT_2=
# NEXT_PUBLIC_AVATAR_DEFAULT_3=

# Fallback Avatar Configuration (used when no model is available)
NEXT_PUBLIC_AVATAR_FALLBACK_TYPE=sphere
NEXT_PUBLIC_AVATAR_FALLBACK_COLOR=#4A90E2
NEXT_PUBLIC_USE_FALLBACK_BY_DEFAULT=true

# Avatar Loading Configuration
NEXT_PUBLIC_AVATAR_LOAD_TIMEOUT=10000
NEXT_PUBLIC_AVATAR_MAX_RETRIES=3

# Logging Configuration
# Log level: debug, info, warn, error
NEXT_PUBLIC_LOG_LEVEL=info

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
